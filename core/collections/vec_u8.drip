pub struct VecU8 {
    pub ptr: *mut u8,
    pub len: usize,
    pub capacity: usize
}

pub fn VecU8::new() -> VecU8 {
    VecU8 {
        ptr: 0 as *u8,
        len: 0,
        capacity: 0,
    }
}

pub fn VecU8::get(*self, index: usize) -> i32 {
    if index > self->len - 1 {
        print("[VecU8::get] Index {} is out of bounds for len {}\n", index, self->len);
        exit(1);
    }

    *(self->ptr + index)
}

pub fn VecU8::push(*mut self, value: i32) {
    // regrow to 2x cap
    if self->len == self->capacity {
       self.regrow(max(self.capacity * 2, 8))
    }

    *(self->ptr + self->len) = value;
    self->len = self->len + 1;
}

pub fn VecU8::extend(*mut self, slice: [u8]) {
    let mut i = 0;

    if self->capacity - self->len < slice.len {
        self->regrow(self->capacity + slice.len);
    }

    memcpy(self->ptr + self->len, slice.ptr, slice.len);
}

pub fn VecU8::clear(*mut self) {
    self->len = 0;
}

fn VecU8::regrow(*mut self, new_capacity: usize) {
    self->capacity = new_capacity;
    
    let new_ptr = malloc(self->capacity) as *i32;
    
    if new_ptr == 0 as *i32 {
        print("[VecU8::regrow] Failed to allocate memory\n");
        exit(1);
    }
    
    memcpy(new_ptr as *any, self->ptr as *any, self->len);
    
    free(self->ptr as *any);
    self->ptr = new_ptr;
}