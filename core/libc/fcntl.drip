// File creation flags for use in the oflag value to open() and openat()
pub const O_CLOEXEC: i32 =   0x0001;
pub const O_CREAT: i32 =   0x0002;
pub const O_DIRECTORY: i32 =   0x0004;
pub const O_EXCL: i32 =   0x0008;
pub const O_NOCTTY: i32 =   0x0010;
pub const O_NOFOLLOW: i32 =   0x0020;
pub const O_TRUNC: i32 =   0x0040;
pub const O_TTY_INIT: i32 =   0x0080;
// File status flags for open(), openat(), and fcntl()
pub const O_APPEND: i32 =   0x0100;
pub const O_DSYNC: i32 =   0x0200;
pub const O_NONBLOCK: i32 =   0x0400;
pub const O_RSYNC: i32 =   0x0800;
pub const O_SYNC: i32 =   0x0200;
// Mask for file access modes
pub const O_ACCMODE: i32 =   0xF000;
// File access modes for open(), openat(), and fcntl()
pub const O_EXEC: i32 =   0x1000;
pub const O_RDONLY: i32 =   0x2000;
pub const O_RDWR: i32 =   0xA000;
pub const O_SEARCH: i32 =   0x4000;
pub const O_WRONLY: i32 =   0x8000

pub fn open(path: *u8, flags: i32, mode: u16) -> i32 {
    syscall(2, path, flags, mode)
}

pub fn open_str(path: str, flags: i32, mode: u16) -> i32 {
    let mut buffer = [0u8; 256];
    strncopy(&mut buffer, path.ptr, 255);

    open(&buffer, flags, mode)
}