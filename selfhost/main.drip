    // TODO: read from file
    // let source_file = read_to_vec(argv[1]);

    
fn main(argv: [cstr]) {

    let source_file = "fn main() -> i32 { 67 }";
    let lexer = Lexer::new(source_file);

    let mut token: Token = lexer.next();

    while token.kind != TokenKind::Eof {
        print(
            "kind = {}, start = {}, end = {}\n",
            token_kind_to_string(token.kind),
            token.span.start,
            token.span.end
        );

        token = lexer.next();
    }

    print("EOF\n");
}


struct Span {
    start: usize,
    end: usize,
}

fn Span::new(start: usize,end: usize) -> Span {
    Span {
        start: start,
        end: end,
    }
}

enum TokenKind {
    // Words
    Keyword,          // fn | let | mut
    Identifier,       // main

    // Literals
    BooleanLiteral,    // true
    ByteLiteral,       // b'A'
    CharLiteral,       // 'A'
    IntegerLiteral,    // 1
    FloatLiteral,      // 1.0
    StringLiteral,     // "hello, world"
    ByteStringLiteral, // b"hello, world"
    CStringLiteral,    // c"hello, world"

    // Delimiters
    OpenParen,    // (
    CloseParen,   // )
    OpenBracket,  // [
    CloseBracket, // ]
    OpenBrace,    // {
    CloseBrace,   // }
    Semicolon,    // ;
    Comma,        // ,

    // Other
    Dot,         // .
    Colon,       // :
    DoubleColon, // ::
    Arrow,       // ->

    // Unary Ops
    Bang,  // !
    Tilde, // ~

    // Unary + Binary Ops
    Asterisk,  // *
    Minus,     // -
    Ampersand, // &

    // Binary Ops
    Plus,                 // +
    Divide,               // /
    Modulus,              // %
    LogicalAnd,           // &&
    LogicalOr,            // ||
    BitwiseXor,           // ^
    BitwiseOr,            // |
    ShiftLeft,            // <<
    ShiftRight,           // >>
    DoubleEquals,         // ==
    NotEquals,            // !=
    LessThan,             // <
    LessThanOrEqualTo,    // <=
    GreaterThan,          // >
    GreaterThanOrEqualTo, // >=

    // Assignment
    Equals,           // =
    PlusEquals,       // +=
    MinusEquals,      // -=
    MultiplyEquals,   // *=
    DivideEquals,     // /=
    ModulusEquals,    // %=
    LogicalAndEquals, // &&=
    LogicalOrEquals,  // ||=
    BitwiseXorEquals, // ^=
    BitwiseAndEquals, // &=
    BitwiseOrEquals,  // |=
    ShiftLeftEquals,  // <<=
    ShiftRightEquals, // >>=

    Error,
    Eof,
}


struct Token {
    kind: TokenKind,
    span: Span,
}


enum Keyword {
    Fn,
    Let,
    Const,
    Static,
    Struct,
    Enum,
    Union,
    Mut,
    Self,
}

struct Lexer {
    source: str,
    position: usize,
    line_number: usize,
    // peek_queue: *TokenNode,
}

// struct TokenNode {
//     prev: *TokenNode,
//     next: *TokenNode,
//     token: Token
// }

//  fn Lexer::peek(*mut self) -> Token {
//     return Token {

//     }
// }

fn Lexer::new(source: str) -> Lexer {
    //print("source.ptr = {}\n", source.ptr);
   // print("source.len = {}\n", source.len);

    Lexer {
        source: source,
        position: 0,
        line_number: 0,
    }
}

fn Lexer::next(*mut self) -> Token {
    // print("calling next\n");
    // print("(*self).position = {}\n", (*self).position);
    // print("(*self).source = {}\n", &(*self).source);
    // print("(*self).source.ptr = {}\n", (*self).source.ptr);
    // print("(*self).source.len = {}\n", (*self).source.len);
    // print("self = {}\n", self);

    while (*self).position < (*self).source.len {
        let c = (*self).source[(*self).position];

        // print("c = {}\n", c as u32);


        // we only allow ascii chars, return an error if we find anything else
        if c as u32 > 127 {
            return Token {
                kind: TokenKind::Error,
                span: Span::new((*self).position, (*self).position + 1),
            };
        }

        let has_next = (*self).position + 1 < (*self).source.len;
        let has_next_2 = (*self).position + 2 < (*self).source.len;

        let token: Token =
        // Ignore whitespace
        if is_whitespace(c) {
            (*self).ignore_whitespace();
            continue;
        }
        // Ignore comments
        else if c == '/' && has_next &&  (*self).source[(*self).position + 1] == '/' {
            (*self).ignore_line();
            continue;
        }
        // Integer and float literals
        else if is_digit(c) || (c == '.' && has_next && is_digit((*self).source[(*self).position + 1])) {
            (*self).read_number()
        }
        // Identifiers, keywords, and boolean literals
        else if is_alphabetic(c) || c == '_' {
            (*self).read_word()
        }
        // Arrow (->)
        else if c == '-' && has_next && (*self).source[(*self).position + 1] == '>' {
            (*self).read_double(TokenKind::Arrow)
        }
        // Double colon (::)
        else if c == ':' && has_next && (*self).source[(*self).position + 1] == ':' {
            (*self).read_double(TokenKind::DoubleColon)
        }
        // Double Equals (==)
        else if c == '=' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::DoubleEquals)
        }
        // Not Equals (!=)
        else if c == '!' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::NotEquals)
        }
        // Less than or equal (<=)
        else if c == '<' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::LessThanOrEqualTo)
        }
        // Greater than or equal (>=)
        else if c == '>' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::GreaterThanOrEqualTo)
        }
        // Plus equals (+=)
        else if c == '+' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::PlusEquals)
        }
        // Minus equals (-=)
        else if c == '-' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::MinusEquals)
        }
        // Multiply equals (*=)
        else if c == '*' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::MultiplyEquals)
        }
        // Divide equals (/=)
        else if c == '/' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::DivideEquals)
        }
        // Modulus equals (%=)
        else if c == '%' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::ModulusEquals)
        }
        // Bitwise and equals (&=)
        else if c == '&' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::BitwiseAndEquals)
        }
        // Bitwise or equals (|=)
        else if c == '|' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::BitwiseOrEquals)
        }
        // Bitwise xor equals (^=)
        else if c == '^' && has_next && (*self).source[(*self).position + 1] == '=' {
            (*self).read_double(TokenKind::BitwiseXorEquals)
        }
        // Shift left equals (<<=)
        else if c == '<' && has_next && (*self).source[(*self).position + 1] == '<' && has_next_2 && (*self).source [(*self).position + 2] == '=' {
            (*self).read_triple(TokenKind::ShiftLeftEquals)
        }
        // Shift right equals (>>=)
        else if c == '>' && has_next && (*self).source[(*self).position + 1] == '>' && has_next_2 && (*self).source [(*self).position + 2] == '=' {
            (*self).read_triple(TokenKind::ShiftRightEquals)
        }
        // Shift left (<<)
        else if c == '<' && has_next && (*self).source[(*self).position + 1] == '<' {
            (*self).read_double(TokenKind::ShiftLeft)
        }
        // Shift right (>>)
        else if c == '>' && has_next && (*self).source[(*self).position + 1] == '>' {
            (*self).read_double(TokenKind::ShiftRight)
        }
        // Logical and equals (&&=)
        else if c == '&' && has_next && (*self).source[(*self).position + 1] == '&' && has_next_2 && (*self).source [(*self).position + 2] == '=' {
            (*self).read_triple(TokenKind::LogicalAndEquals)
        }
        // Logical or equals (||=)
        else if c == '|' && has_next && (*self).source[(*self).position + 1] == '|' && has_next_2 && (*self).source [(*self).position + 2] == '=' {
            (*self).read_triple(TokenKind::LogicalOrEquals)
        }
        // Logical And (&&)
        else if c == '&' && has_next && (*self).source[(*self).position + 1] == '&' {
            (*self).read_double(TokenKind::LogicalAnd)
        }
        // Logical Or (||)
        else if c == '|' && has_next && (*self).source[(*self).position + 1] == '|' {
            (*self).read_double(TokenKind::LogicalOr)
        } else {
            // Table of single char tokens (matched after longer sequences are checked for)
            let single_tokens: [(char, TokenKind); 23] = [
                ('(', TokenKind::OpenParen),
                (')', TokenKind::CloseParen),
                ('[', TokenKind::OpenBracket),
                (']', TokenKind::CloseBracket),
                ('{', TokenKind::OpenBrace),
                ('}', TokenKind::CloseBrace),
                (';', TokenKind::Semicolon),
                (',', TokenKind::Comma),
                ('!', TokenKind::Bang),
                ('~', TokenKind::Tilde),
                ('.', TokenKind::Dot),
                (':', TokenKind::Colon),
                ('*', TokenKind::Asterisk),
                ('-', TokenKind::Minus),
                ('=', TokenKind::Equals),
                ('+', TokenKind::Plus),
                ('/', TokenKind::Divide),
                ('%', TokenKind::Modulus),
                ('^', TokenKind::BitwiseXor),
                ('&', TokenKind::Ampersand),
                ('|', TokenKind::BitwiseOr),
                ('<', TokenKind::LessThan),
                ('>', TokenKind::GreaterThan),
            ];

            let mut i = 0;

            while i < 23 {
                let s = single_tokens[i];

                if c == s.v0 {
                    return (*self).read_single(s.v1);
                }

                i = i + 1;
            }

            Token {
                kind: TokenKind::Error,
                span: Span::new((*self).position, (*self).position + 1),
            }
        };

        return token;
    }



    Token {
        kind: TokenKind::Eof,
        span: Span::new((*self).position, (*self).position),
    }
}

fn Lexer::ignore_whitespace(*mut self) {
    // TODO

    (*self).position = (*self).position + 1;

}

fn Lexer::ignore_line(*mut self) {
    // TODO
    (*self).position = (*self).position + 1;

}

fn Lexer::consume_char(*mut self) {
    // TODO: check utf-8 length
    (*self).position = (*self).position + 1;
}

fn Lexer::read_number(*mut self) -> Token {
    let start_position = (*self).position;


    let mut peek_idx = start_position;
    while peek_idx < (*self).source.len {
        let c = (*self).source[peek_idx];

        if !is_digit(c) {
            break;
        }; // FIXME: we shouldnt need this semicolon here (parser thinks this is a function call)

        (*self).position = (*self).position + 1;

        peek_idx = peek_idx + 1;
    }

    let span = Span::new(start_position, (*self).position);

    Token {
        kind: TokenKind::IntegerLiteral,
        span: span,
    }
}

fn Lexer::read_word(*mut self) -> Token {
    let start_position = (*self).position;

     // print("[Lexer::read_word] self = {}\n", self);
     // print("[Lexer::read_word] start_position  = {}\n", start_position);
     // print("[Lexer::read_word] (*self).source.len  = {}\n", (*self).source.len);

    let mut peek_idx = start_position;
    while peek_idx < (*self).source.len {
        let c = (*self).source[peek_idx];

        //  print("[Lexer::read_word] c = {}\n", c as u32);
        //  print("[Lexer::read_word] is_alphanumeric(c) = {}\n", is_alphanumeric(c) as u8 as u32);


        if !is_alphanumeric(c) && c != '_' {
           // print("breaking\n");
            break;
        }; // FIXME: we shouldnt need this semicolon here (parser thinks this is a function call)

       // print("consuming\n");

        // (*self).consume_char();
        (*self).position = (*self).position + 1;

        peek_idx = peek_idx + 1;
    }

    let span = Span::new(start_position, (*self).position);

    //    print("read {} chars\n", (*self).position);

    // TODO: parse keywords and boolean literals

    Token {
        kind: TokenKind::Identifier,
        span: span,
    }
}

fn Lexer::read_single(*mut self, kind: TokenKind) -> Token {
    let start = (*self).position;
    (*self).position = (*self).position + 1;

    Token {
        kind: kind,
        span: Span::new(start, (*self).position),
    }
}

fn Lexer::read_double(*mut self, kind: TokenKind) -> Token {
    let start = (*self).position;
    (*self).position = (*self).position + 2;

    Token {
        kind: kind,
        span: Span::new(start, (*self).position),
    }
}

fn Lexer::read_triple(*mut self, kind: TokenKind) -> Token {
    // TODO

    (*self).position = (*self).position + 3;


    Token {
        kind: TokenKind::Eof,
        span: Span::new(0, 0),
    }
}

fn is_whitespace(c: char) -> bool {
    c == ' ' || (c as u32 >= 9 && c as u32 <= 13)
}


fn is_digit(c: char) -> bool {
    c as u32 >= '0' as u32 && c as u32 <= '9' as u32
}


fn is_alphabetic(c: char) -> bool {
    (c as u32 >= 'A' as u32 && c as u32 <= 'Z' as u32) || (c as u32 >= 'a' as u32 && c as u32 <= 'z' as u32)
}

fn is_alphanumeric(c: char) -> bool {
    // print("is_alphanumeric\n");
    is_alphabetic(c) || is_digit(c)
}

fn token_kind_to_string(kind: TokenKind) -> str {

    if kind == TokenKind::Keyword {
        "keyword"
    } else if kind == TokenKind::Identifier {
         "ident"
    } else if kind == TokenKind::BooleanLiteral {
        "bool"
    } else if kind == TokenKind::ByteLiteral {
        "byte"
    } else if kind == TokenKind::CharLiteral {
        "char"
    } else if kind == TokenKind::IntegerLiteral {
        "int"
    } else if kind == TokenKind::FloatLiteral {
        "float"
    } else if kind == TokenKind::StringLiteral {
        "string"
    } else if kind == TokenKind::ByteStringLiteral {
        "byte_string"
    } else if kind == TokenKind::CStringLiteral {
        "c_string"
    } else if kind == TokenKind::OpenParen {
        "open_paren"
    } else if kind == TokenKind::CloseParen {
        "close_paren"
    } else if kind == TokenKind::OpenBracket {
        "open_bracket"
    } else if kind == TokenKind::CloseBracket {
        "close_bracket"
    } else if kind == TokenKind::OpenBrace {
        "open_brace"
    } else if kind == TokenKind::CloseBrace {
        "close_brace"
    } else if kind == TokenKind::Semicolon {
        "semicolon"
    } else if kind == TokenKind::Comma {
        "comma"
    } else if kind == TokenKind::Dot {
        "dot"
    } else if kind == TokenKind::Colon {
        "colon"
    } else if kind == TokenKind::DoubleColon {
        "double_colon"
    } else if kind == TokenKind::Arrow {
        "arrow"
    } else if kind == TokenKind::Eof {
        "<eof>"
    } else {
        "other"
    }
}
