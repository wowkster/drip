//! This example is an implementation of the Rule 110 algorithm, commonly used to
//! show that a programming language is turring complete. We are very close to
//! getting this to work as soon as we get structure methods and array indexing
//! implemented.

// This is where we'll get Int32Vec in the future
// include core::collections;

fn memcpy(dest: *mut any, src: *mut any, len: usize) {
    let mut i = 0;

    while i < len {
        *((dest + i as *any) as *u8) = *((src + i as *any) as *u8);
        i = i + 1;
    }
}

static mut ARENA: [u8; 4096] = [0; 4096];
static mut POSITION: usize = 0;

/// allocate memory from a static arena
fn malloc(size: usize) -> *mut any {
    if POSITION + size > 4096 {
        return 0 as *mut any;
    }

    let addr = (&mut ARENA) as *u8 + POSITION as *u8;
    POSITION = POSITION + size;

    // print("[malloc] allocated 0x{} bytes at 0x{}\n", size, addr);

    addr as *any
}

fn free(ptr: *any) {
    // no-op
}

struct Int32Vec {
    ptr: *i32,
    len: usize,
    capacity: usize
}

fn Int32Vec::new() -> Int32Vec {
    Int32Vec {
        ptr: 0 as *i32,
        len: 0,
        capacity: 0,
    }
}

fn Int32Vec::from_slice(ptr: *[i32; 15], len: usize) -> Int32Vec {
    let new_ptr = malloc(len * 4) as *i32;

    if new_ptr == 0 as *i32 {
        print("[Int32Vec::from_slice] Failed to allocate memory");
        exit(1);
    }

    memcpy(new_ptr as *any, (*(ptr as *any as *usize)) as *any, len * 4);

    Int32Vec {
        ptr: new_ptr,
        len: len,
        capacity: len,
    }
}

fn Int32Vec::get(*self, index: usize) -> i32 {
    if index > (*self).len - 1 {
        print("[Int32Vec::get] Index {} is out of bounds for len {}", index, (*self).len);
        exit(1);
    }

    *((*self).ptr + (index * 4))
}

fn Int32Vec::push(*mut self, value: i32) {
    // regrow to 2x cap
    if (*self).len == (*self).capacity {
        (*self).capacity = if (*self).capacity == 0 {
            8
        } else {
            (*self).capacity * 2
        };

        let new_ptr = malloc((*self).capacity * 4) as *i32;

        if new_ptr == 0 as *i32 {
            print("[Int32Vec::push] Failed to allocate memory\n");
            exit(1);
        }

        memcpy(new_ptr as *any, (*self).ptr as *any, (*self).len * 4);

        free((*self).ptr as *any);
        (*self).ptr = new_ptr;
    }

    *((*self).ptr + (*self).len * 4) = value;
    (*self).len = (*self).len + 1;
}

fn Int32Vec::clear(*mut self) {
    (*self).len = 0;
}

/// Applies Rule 110 to a given neighborhood.
fn rule110(neighborhood: (i32, i32, i32)) -> i32 {
    if neighborhood == (1, 1, 1) {
        0
    } else if neighborhood == (1, 1, 0) {
        1
    } else if neighborhood == (1, 0, 1) {
        1
    } else if neighborhood == (1, 0, 0) {
        0
    } else if neighborhood == (0, 1, 1) {
        1
    } else if neighborhood == (0, 1, 0) {
        1
    } else if neighborhood == (0, 0, 1) {
        1
    } else if neighborhood == (0, 0, 0) {
        0
    } else {
        print("reached unreachable code path\n");
        exit(1)
    }
}

/// Evolves a row of cells over a number of generations.
fn evolve(initial_cells: Int32Vec, generations: usize) {
    let mut i = 0;
    while i < initial_cells.len {
        if initial_cells.get(i) == 1 {
            print("■");
        } else {
            print(" ");
        }

        i = i + 1;
    }

    print("\n");

    let mut previous_cells = initial_cells;
    let mut current_cells = Int32Vec::new();

    let mut generation = 0;
    while generation < generations {
        current_cells.clear();

        let previous_len = previous_cells.len;

        let mut i = 0;
        while i < previous_len {
            let neighborhood = (
                previous_cells.get(if i == 0 {
                    previous_len - 1
                } else {
                    i - 1
                }),
                previous_cells.get(i),
                previous_cells.get(if i == previous_len - 1 {
                    0
                } else {
                    i + 1
                })
            );

            current_cells.push(rule110(neighborhood));

            i = i + 1;
        }

        i = 0;
        while i < current_cells.len {
            if current_cells.get(i) == 1 {
                print("■");
            } else {
                print(" ");
            }

            i = i + 1;
        }

        print("\n");

        let tmp = previous_cells;
        previous_cells = current_cells;
        current_cells = tmp;

        generation = generation + 1;
    }
}

fn main() {
    let n = 32;
    let generations = 24;

    print("Rule 110 Example (n = {}, generations = {})\n", n, generations);

    let initial_cells = Int32Vec::new();

    let mut j = 0;
    while j < n {
        initial_cells.push(if j == n -1 {1} else {0});

        j = j + 1;
    }

    evolve(initial_cells, generations)
}
