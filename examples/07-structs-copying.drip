//! Structure methods and constants not implemeted yet. This is just some
//! experimentation for what they could look like

struct Node {
    a: u32,
    b: i64,
}

fn main() {
    let node = returns_struct_copy();
    
    print("a = {}, b = {}\n", node.a, node.b);

    accepts_struct_copy(node);

    /// should create a full copy of the struct
    let copy = node;

    node.b = 4;
    
    print("a = {}, b = {}\n", copy.a, copy.b);

    accepts_struct_copy(node);
    accepts_struct_copy(copy);

    print("a = {}, b = {}\n", node.a, node.b);
    print("a = {}, b = {}\n", copy.a, copy.b);
}

/// this function returns a copy of the struct which is created. the memory for
/// the returned struct is allocated by the caller
fn returns_struct_copy() -> Node {
     let node = Node {
        a: 1,
        b: 2
    };

    node
}

/// this function gets a copy of the struct which is created in the caller and
/// passed by reference
fn accepts_struct_copy(node: Node) {
    node.a = 3;

    print("a = {}, b = {}\n", node.a, node.b);
}
